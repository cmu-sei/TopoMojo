    <PackageReference Include="DiscUtils.Iso9660" Version="0.16.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TopoMojo.Api\TopoMojo.Api.csproj" />
  </ItemGroup>
</Project>
